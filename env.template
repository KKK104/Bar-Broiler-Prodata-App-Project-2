# Supabase Configuration
# Replace these with your actual Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Developer Authentication (for local development)
DEVELOPER_EMAIL=leonacinintal@gmail.com
DEVELOPER_PASSWORD_HASH=$2a$10$your-hashed-password-here

# JWT Secret (for local development)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Weather API Configuration (for Humidity Monitoring)
# Get your API keys from:
# - OpenWeatherMap: https://openweathermap.org/api
# - WeatherAPI: https://www.weatherapi.com/
NEXT_PUBLIC_OPENWEATHER_API_KEY=your-openweathermap-api-key-here
NEXT_PUBLIC_WEATHERAPI_KEY=your-weatherapi-key-here

# Google Maps API (for Map Picker)
# Get your API key from: https://developers.google.com/maps/documentation/javascript/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Cron Job Security (for automatic humidity updates)
# Set a secure secret for cron job authentication
CRON_SECRET=your-secure-cron-secret-here